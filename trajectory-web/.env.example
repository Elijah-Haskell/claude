# Trajectory for the web: build-time configuration (Vite reads VITE_* at `npm run build`).

# The Trajectory API: the same server, accounts, saved plans and AI as the iPhone app.
# Default: https://api.trajectoryapp.org
VITE_API_BASE_URL=https://api.trajectoryapp.org

# Sign in with Apple JS: the Services ID registered for this web origin (Apple Developer → Identifiers →
# Services IDs, with "Sign in with Apple" enabled and this site's domain + Return URL). NOT the iOS bundle id.
VITE_APPLE_CLIENT_ID=
# The Return URL registered with that Services ID. Default: the page's own origin and path.
# VITE_APPLE_REDIRECT_URI=https://app.trajectoryapp.org/

# RevenueCat Web Billing public key (RevenueCat → Project → the Web Billing app → API keys, "rcb_..." key).
VITE_REVENUECAT_WEB_KEY=

# "false" builds the browser preview the mobile repo also has: no account, the plan stays in this browser.
# VITE_ACCOUNT_REQUIRED=false

# Test builds only (tests/run-smoke.mjs sets these for the mock API; leave them out of a real build).
# VITE_TEST_SIGN_IN=1   adds a "Test sign-in" button for tests/mock-server.mjs
# VITE_TEST_PRO=1       the browser holds Trajectory Pro without RevenueCat (the mock's MOCK_PRO=1 accounts)
