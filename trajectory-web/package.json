{
  "name": "trajectory-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trajectory for the web: an academic planner that turns syllabi and deadlines into an adaptive, conflict-safe semester plan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
