{
  "name": "lawdesk",
  "private": true,
  "type": "module",
  "description": "Practice management for a Kansas law firm: matters, tasks and workflows first.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts tests/**/*.test.ts",
    "test:browser": "NODE_PATH=$(npm root -g) node --disable-warning=ExperimentalWarning tests/browser/smoke.ts"
  }
}
